{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "type",
    "name",
    "summary",
    "description",
    "url",
    "areas",
    "technologies",
    "languages",
    "updatedAt"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "type": {
      "enum": [
        "courses",
        "platforms",
        "universities",
        "bootcamps",
        "roadmaps",
        "books",
        "certifications",
        "news",
        "blogs",
        "newsletters",
        "podcasts",
        "youtube",
        "creators",
        "articles",
        "tutorials",
        "studies",
        "case-studies",
        "reports",
        "communities",
        "events",
        "meetups",
        "conferences",
        "hackathons",
        "tools",
        "open-source",
        "challenges",
        "labs",
        "jobs",
        "internships",
        "scholarships",
        "mentoring",
        "volunteering"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "pattern": "^https://"
    },
    "areas": {
      "$ref": "#/definitions/ids"
    },
    "technologies": {
      "$ref": "#/definitions/optionalIds"
    },
    "languages": {
      "$ref": "#/definitions/ids"
    },
    "countries": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "demo": {
      "type": "boolean"
    },
    "communityLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "states"],
          "properties": {
            "scope": {
              "const": "regional"
            },
            "states": {
              "type": "array",
              "minItems": 1,
              "maxItems": 27,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "AC",
                  "AL",
                  "AP",
                  "AM",
                  "BA",
                  "CE",
                  "DF",
                  "ES",
                  "GO",
                  "MA",
                  "MT",
                  "MS",
                  "MG",
                  "PA",
                  "PB",
                  "PR",
                  "PE",
                  "PI",
                  "RJ",
                  "RN",
                  "RS",
                  "RO",
                  "RR",
                  "SC",
                  "SP",
                  "SE",
                  "TO"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "enum": ["national", "international"]
            }
          }
        }
      ]
    },
    "communityPlatforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "whatsapp",
          "telegram",
          "discord",
          "slack",
          "facebook",
          "linkedin",
          "meetup",
          "reddit",
          "github",
          "discourse",
          "circle",
          "mighty-networks",
          "website",
          "other"
        ]
      }
    },
    "communityModality": {
      "enum": ["online", "in-person", "hybrid"]
    }
  },
  "definitions": {
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "optionalIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": ["communityLocation"]
          },
          {
            "required": ["communityPlatforms"]
          },
          {
            "required": ["communityModality"]
          }
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "communities"
          }
        }
      }
    }
  ]
}
